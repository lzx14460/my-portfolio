<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.system.mapper.HealthRecordMapper">

    <resultMap id="BaseResultMap" type="com.example.system.entity.HealthRecord">
        <id column="id" property="id"/>
        <result column="user_id" property="userId"/>
        <result column="height" property="height"/>
        <result column="weight" property="weight"/>
        <result column="record_date" property="recordDate"/>
        <result column="create_time" property="createTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, user_id, height, weight, record_date, create_time
    </sql>

    <!-- 插入健康记录 -->
    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO health_record (user_id, height, weight, record_date)
        VALUES (#{userId}, #{height}, #{weight}, #{recordDate})
    </insert>

    <!-- 根据用户ID查询所有健康记录（按日期升序） -->
    <select id="selectByUserId" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM health_record
        WHERE user_id = #{userId}
        ORDER BY record_date ASC
    </select>

    <!-- 查询用户指定日期的健康记录 -->
    <select id="selectByUserIdAndDate" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM health_record
        WHERE user_id = #{userId} AND record_date = #{recordDate}
        LIMIT 1
    </select>

    <!-- 查询用户今天的健康记录（兼容旧接口） -->
    <select id="selectTodayRecord" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM health_record
        WHERE user_id = #{userId} AND record_date = #{today}
        LIMIT 1
    </select>

    <!-- 根据ID查询 -->
    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM health_record WHERE id = #{id}
    </select>

    <!-- 更新健康记录 -->
    <update id="update">
        UPDATE health_record
        SET height = #{height}, weight = #{weight}
        WHERE id = #{id}
    </update>

    <!-- 根据ID删除健康记录 -->
    <delete id="deleteById">
        DELETE FROM health_record WHERE id = #{id}
    </delete>

    <!-- 删除用户指定日期的健康记录 -->
    <delete id="deleteByUserIdAndDate">
        DELETE FROM health_record WHERE user_id = #{userId} AND record_date = #{recordDate}
    </delete>

</mapper>