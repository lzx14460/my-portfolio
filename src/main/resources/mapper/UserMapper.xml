    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user (
            username, password, name, gender, phone, email,
            role, avatar, student_id, college, class_name, status,
            applied_role, apply_status, apply_time
        ) VALUES (
                     #{username}, #{password}, #{name}, #{gender}, #{phone}, #{email},
                     #{role}, #{avatar}, #{studentId}, #{college}, #{className}, #{status},
                     #{appliedRole}, #{applyStatus}, #{applyTime}
                 )
    </insert>

    <update id="update">
        UPDATE user
        <set>
            <if test="username != null">username = #{username},</if>
            <if test="password != null">password = #{password},</if>
            <if test="name != null">name = #{name},</if>
            <if test="gender != null">gender = #{gender},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            <if test="role != null">role = #{role},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="college != null">college = #{college},</if>
            <if test="className != null">class_name = #{className},</if>
            <if test="status != null">status = #{status},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>
    <!-- 管理员更新用户信息 -->
    <update id="updateByAdmin">
        UPDATE user
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="studentId != null">student_id = #{studentId},</if>
            <if test="college != null">college = #{college},</if>
            <if test="className != null">class_name = #{className},</if>
            <if test="phone != null">phone = #{phone},</if>
            <if test="email != null">email = #{email},</if>
            update_time = NOW()
        </set>
        WHERE id = #{id}
    </update>
    <delete id="deleteById">
        DELETE FROM user WHERE id = #{id}
    </delete>

    <!-- 查询待审批的用户列表 -->
    <select id="selectPendingApprovals" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE apply_status = 1
        ORDER BY apply_time ASC
    </select>
    <!-- 审批历史 -->
    <select id="selectApprovedHistory" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user
        WHERE apply_status IN (2, 3)
        ORDER BY approve_time DESC
        LIMIT 20
    </select>
    <!-- 更新申请状态 -->
    <update id="updateApplyStatus">
        UPDATE user
        SET apply_status = #{status},
        approve_time = NOW(),
        approve_remark = #{approveRemark}
        <if test="status == 2">
            , role = applied_role
        </if>
        WHERE id = #{id}
    </update>

    <!-- 根据手机号查询 -->
    <select id="selectByPhone" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user WHERE phone = #{phone}
    </select>

</mapper>