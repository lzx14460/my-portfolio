<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.example.system.mapper.UserMapper">

    <resultMap id="BaseResultMap" type="com.example.system.entity.User">
        <id column="id" property="id"/>
        <result column="username" property="username"/>
        <result column="password" property="password"/>
        <result column="name" property="name"/>
        <result column="gender" property="gender"/>
        <result column="phone" property="phone"/>
        <result column="email" property="email"/>
        <result column="role" property="role"/>
        <result column="avatar" property="avatar"/>
        <result column="student_id" property="studentId"/>
        <result column="college" property="college"/>
        <result column="class_name" property="className"/>
        <result column="status" property="status"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="apply_status" property="applyStatus"/>
        <result column="applied_role" property="appliedRole"/>
        <result column="approve_time" property="approveTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        id, username, password, name, gender, phone, email, role, avatar,
        student_id, college, class_name, status, create_time, update_time,
          applied_role, apply_status, apply_time, approve_time, approve_remark
    </sql>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user WHERE id = #{id}
    </select>

    <select id="selectByUsername" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user WHERE username = #{username}
    </select>

    <select id="selectAll" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user ORDER BY create_time DESC
    </select>

    <select id="selectByPage" resultMap="BaseResultMap">
        SELECT <include refid="Base_Column_List"/>
        FROM user ORDER BY create_time DESC
        LIMIT #{start}, #{size}
    </select>

    <select id="selectCount" resultType="int">
        SELECT COUNT(*) FROM user
    </select>

